# Safe Flow 클라우드/VPS 배포용 예시
# 사용: 서버에서 cp .env.deploy.example .env  후 값 수정 → docker compose up -d

# 공개 URL (다른 작업자 Cursor·앱이 쓰는 주소)
DENSITY_API_BASE_URL=http://YOUR_SERVER_IP:3780
REALTIME_SAFETY_PUBLIC_URL=http://YOUR_SERVER_IP:8790

# 포트 (방화벽에서 둘 다 개방)
API_PUBLISH_PORT=3780
VISION_PUBLISH_PORT=8790

CORS_ORIGINS=*
VISION_SAHI256=1

# 선택 — 있으면 실데이터, 없으면 모의
KMA_SERVICE_KEY=
SK_OPEN_API_APP_KEY=
