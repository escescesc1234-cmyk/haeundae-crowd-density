# ─── 기상청 단기예보 ────────────────────────────────────────────────────────────
# 공공데이터포털 > 기상청_단기예보 조회서비스 인증키
KMA_SERVICE_KEY=
KMA_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getVilageFcst
# 광안리 해수욕장 격자 (수영구 광안동 인근)
KMA_NX=98
KMA_NY=76
# 선택: 고정 발표시각(0200/0500/0800/1100/1400/1700/2000/2300). 비우면 현재 시각 기준 자동 선택
# KMA_BASE_TIME=0800

# ─── SK 통신사 혼잡도 ───────────────────────────────────────────────────────────
# SK open API > 대시보드 > 앱 키 (장소 혼잡도 상품 구독 필요)
# 기본은 비활성. 관리자 운영도구 「SK API 테스트 연결」 또는 useTelecom=true 일 때만 호출
SK_OPEN_API_APP_KEY=
SK_PUZZLE_PLACE_BASE_URL=https://apis.openapi.sk.com/puzzle/place/congestion/rltm/pois
# Free 한도 보호: 캐시(ms), 429 후 재시도 금지(ms)
# SK_TELECOM_CACHE_MS=600000
# SK_TELECOM_QUOTA_COOLDOWN_MS=21600000

# ─── 부산광역시 ITS 교통 CCTV API ─────────────────────────────────────────────
# 공공데이터포털: 부산광역시_CCTV 설치 현황정보 (dataSetSn: 15120867)
# 신청: https://www.data.go.kr/data/15120867/openapi.do
# 제공: CCTV 설치위치, 영상 스트림 URL, 위경도 / 비워두면 Mock 모드
BUSAN_ITS_API_KEY=
# BUSAN_ITS_BASE_URL=https://apis.data.go.kr/6260000/BusanCCTVService/getCCTVInfo

# ─── 해운대구 CCTV 정보 조회 API ──────────────────────────────────────────────
# 공공데이터포털: 부산광역시 해운대구_CCTV 정보 조회 서비스 (dataSetSn: 15070811)
# 신청: https://www.data.go.kr/data/15070811/openapi.do
# 요청주소: http://apis.data.go.kr/3330000/HeaundaeCctvInfoService/getCctvList
# 개발계정 자동승인 / 운영계정 심의승인 / 비워두면 Mock 모드
HAEUNDAE_CCTV_API_KEY=

# ─── 부산시설공단 공영주차장 실시간 API ────────────────────────────────────────
# 공공데이터포털: 부산시설공단_공영주차장 시설 현황 조회 서비스 (dataSetSn: 15157490)
# 신청: https://www.data.go.kr/data/15157490/openapi.do
# 자동승인 / 실시간 업데이트 / 무료 / 비워두면 Mock 모드
BUSAN_PARKING_API_KEY=

# ─── 서버 ───────────────────────────────────────────────────────────────────────
PORT=3780
# Docker/VPS: 0.0.0.0 (기본). 로컬만이면 127.0.0.1
# HOST=0.0.0.0

# ─── 밀도 API 클라이언트 (관광객·관리자 UI / 외부 앱 연동) ─────────────────────
# Node DensityApiClient 기본 baseUrl. 브라우저 UI는 동일 오리진이면 비워도 됨.
DENSITY_API_BASE_URL=http://localhost:3780
# 타 앱 브라우저 연동: * (기본) 또는 허용 Origin 쉼표 목록
# CORS_ORIGINS=*
# 실시간 AI 비전 — 서버 내부 프록시 (Docker: http://vision:8790)
# REALTIME_SAFETY_URL=http://127.0.0.1:8790
# 브라우저에 내려줄 공개 스트림 URL (배포 시 http://서버IP:8790)
# REALTIME_SAFETY_PUBLIC_URL=http://127.0.0.1:8790
# 상시 배포: docs/DEPLOY.md · .env.deploy.example

# ─── 비전 파이프라인 (YOLOv8 + SAHI) ────────────────────────────────────────────
# Windows 예: C:\Users\user\AppData\Local\Programs\Python\Python312\python.exe
# 비우면 PATH의 python / 기본 설치 경로를 사용
VISION_PYTHON=
# 파인튜닝 가중치 경로(기본): vision/models/yolo26s_beach_ft.pt
# SAHI-256 실시간 모니터 (기본 1). 끄려면 0
# VISION_SAHI256=1
