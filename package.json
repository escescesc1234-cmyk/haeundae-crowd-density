{
  "name": "haeundae-crowd-density",
  "version": "1.0.0",
  "description": "광안리 해수욕장 구역별 군중 밀집도 분석 및 3단계 위험 등급 판정 모듈 (AI LAB 안전 관리 연동용)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/start.js",
    "dev": "tsx src/api/start.ts",
    "analyze": "tsx src/cli.ts",
    "vision:analyze": "tsx src/cliVision.ts",
    "vision:realtime": "tsx src/cliRealtimeSafety.ts",
    "vision:finetune": "cd vision && python finetune_beach_max.py",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "crowd-density",
    "gwangalli",
    "safety",
    "risk-level"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
